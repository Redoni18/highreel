{
  "name": "highreel",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "nuxt dev --port 3040",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck",
    "sample": "node scripts/generate-sample.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "check:isolation": "node scripts/check-isolation.mjs",
    "db:migrate": "wrangler d1 migrations apply highreel --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && wrangler d1 migrations apply highreel --local",
    "db:migrate:remote": "wrangler d1 migrations apply highreel --remote",
    "deploy": "nuxt build && wrangler deploy",
    "mail": "command -v mailpit >/dev/null || { echo 'Mailpit is the local test inbox: brew install mailpit' >&2; exit 1; }; mailpit --listen 127.0.0.1:54424 --smtp 127.0.0.1:54425 --smtp-disable-rdns",
    "e2e": "node tests/e2e/run-all.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.54.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-table": "^9.2.8",
    "@tanstack/vue-virtual": "^3.13.40",
    "@vueuse/core": "^15.0.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "modern-screenshot": "^4.7.0",
    "nanoid": "^6.0.2",
    "nodemailer": "^7.0.13",
    "nuxt": "^4.6.1",
    "papaparse": "^5.7.0",
    "read-excel-file": "^9.3.12",
    "reka-ui": "^2.11.0",
    "shadcn-nuxt": "^2.8.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261008.1",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^7.0.12",
    "@types/papaparse": "^5.5.2",
    "playwright-core": "^1.64.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "4.149.0"
  }
}

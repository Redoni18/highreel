// Highreel on Cloudflare Workers (SPEC M2.14): one Worker with static assets,
// D1, R2 and Email Sending. `corepack pnpm dev` reads the bindings from here
// (Nitro's emulation through wrangler's getPlatformProxy, state in
// .wrangler/state/v3); `corepack pnpm build` then `corepack pnpm exec wrangler dev`
// runs the built Worker locally on workerd.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "highreel",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-10-01",
  // node:net, node:tls and node:dns (resolve*, not lookup) come from workerd itself:
  // nodemailer talks SMTP through them.
  "compatibility_flags": ["nodejs_compat"],
  // Served on highreel.app only (P7): no workers.dev address or preview URLs, so
  // there's one origin for links, sign-in and Turnstile (its widget allows highreel.app).
  "routes": [{ "pattern": "highreel.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Workers Logs: requests and the jobs' counts (the app logs no addresses or names).
  "observability": { "enabled": true },
  // Run next to the database (SPEC §7.7). D1's primary is in Frankfurt (a query's
  // meta says served_by_colo FRA); without this the Worker runs wherever the visitor
  // lands, and every query crosses back: from Rio (where Kosovo's IPv6 lands) ~180 ms
  // each, 3-4 in a row per signed-in request. Static files are still served at the
  // visitor's edge; only requests the Worker handles go to Frankfurt, once each.
  "placement": { "region": "aws:eu-central-1" },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
    // The prerendered pages are /terms/index.html etc.: serve them at /terms (their
    // canonical URL), not /terms/.
    "html_handling": "drop-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "highreel",
      // Made 2026-10-13 in the EU jurisdiction (`wrangler d1 create highreel
      // --jurisdiction eu`). Local development uses its own copy (.wrangler/state/v3).
      "database_id": "8eb220db-ac4a-49be-afa4-66a08da5444e",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "highreel-media", "jurisdiction": "eu" }
  ],
  // Public settings. Secrets (NUXT_SECRETS_KEY, NUXT_AUTH_SECRET, NUXT_TURNSTILE_SECRET,
  // NUXT_WHOP_API_KEY, NUXT_WHOP_WEBHOOK_SECRET) are Worker secrets, from
  // .secrets.production.json (gitignored).
  // Locally .env overrides these (Turnstile's test keys there always pass).
  "vars": {
    // The highreel.app Turnstile widget (Managed), made 2026-10-13.
    "NUXT_PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAFVD_ceO81JBqZSn",
    // "Continue with Google" on /login (2026-10-14). Its client ID and secret
    // are Worker secrets (NUXT_GOOGLE_CLIENT_ID, NUXT_GOOGLE_CLIENT_SECRET).
    "NUXT_PUBLIC_AUTH_GOOGLE": "true",
    // Payments (SPEC §10): "" publishes free (until Whop approves the business);
    // "production" makes accounts pay per campaign through the live Whop account,
    // with the Worker secrets NUXT_WHOP_API_KEY and NUXT_WHOP_WEBHOOK_SECRET.
    // Never "sandbox" here (scripts/check-release.mjs stops it): that's .env's.
    "NUXT_PUBLIC_CHECKOUT": ""
  },
  // The scheduled jobs (P4): the same expressions as server/schedule.ts, which
  // says which tasks each one runs. `wrangler dev --test-scheduled` adds
  // /__scheduled?cron=… to fire one locally.
  "triggers": {
    "crons": ["0 * * * *", "0 3 * * *"]
  },
  // Sign-in emails (P3), from hello@highreel.app once the domain is onboarded for
  // Email Sending. Highlight reel emails never use this: they go through the
  // business's own account.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["hello@highreel.app"] }
  ]
}

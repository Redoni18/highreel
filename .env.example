# Recap emails go through each business's own email account (SPEC M2.9); its
# SMTP password is encrypted with this key, and /media links are signed with
# one derived from it (M2.14 P2). Required in production (any long random
# string, e.g. `openssl rand -base64 32`); a development server has a stand-in.
# Changing it means businesses connect their email again.
NUXT_SECRETS_KEY=

# Sign-in (Better Auth, SPEC M2.14 P3). Signs session cookies: required in
# production (`openssl rand -base64 32`); changing it signs everyone out.
NUXT_AUTH_SECRET=
# Cloudflare Turnstile, the bot check on /login and "Keep my work". These are
# Cloudflare's test keys (the invisible widget always passes, and so does the
# server's check). Production: the highreel.app widget's site key is in
# wrangler.jsonc `vars`; its secret is a Worker secret (SPEC M2.14 P7).
NUXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB
NUXT_TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# Per-IP limits on sign-in. Off locally: the tests start many demo sessions
# from one address. Leave it unset in production.
NUXT_AUTH_RATE_LIMIT=false

# Google sign-in (SPEC M2a.2): the provider exists once both are set, and the
# button on /login once NUXT_PUBLIC_AUTH_GOOGLE is true. Redirect URI to
# register with Google: <site>/api/auth/callback/google.
# NUXT_GOOGLE_CLIENT_ID=
# NUXT_GOOGLE_CLIENT_SECRET=
# NUXT_PUBLIC_AUTH_GOOGLE=true

# Local Supabase (values from `supabase status`).
SUPABASE_URL=
# Publishable key: safe in the browser (RLS decides what it can read).
SUPABASE_KEY=
# Secret key: server only, never exposed to the client.
SUPABASE_SECRET_KEY=
# Show the Google button on /login once Google sign-in is configured (SPEC M2a.2).
# NUXT_PUBLIC_AUTH_GOOGLE=true
# Recap emails go through each business's own email account (SPEC M2.9); its
# SMTP password is encrypted with this key. Required in production (any long
# random string, e.g. `openssl rand -base64 32`); locally one is derived from
# SUPABASE_SECRET_KEY. Changing it means businesses connect their email again.
# NUXT_SECRETS_KEY=
